# Copy to .env and change every value. Placeholder values only - never commit a real .env.
# Used by Docker Compose and (via `set -a; source .env; set +a`) by a locally-run backend.

# --- Database ---
PAYSIM_DB_USER=paysim
PAYSIM_DB_PASSWORD=change-me-db-password

# --- Application accounts (HTTP Basic, in-memory, BCrypt-hashed at startup) ---
PAYSIM_OPERATOR_USERNAME=operator
PAYSIM_OPERATOR_PASSWORD=change-me-operator-password
PAYSIM_VIEWER_USERNAME=viewer
PAYSIM_VIEWER_PASSWORD=change-me-viewer-password

# --- Web ---
# Comma-separated list of browser origins allowed to call the API cross-origin.
PAYSIM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to false to hide Swagger UI / OpenAPI docs (recommended for any shared deployment).
PAYSIM_SWAGGER_ENABLED=true
